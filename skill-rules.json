  "kiips-mybatis-guide": {
    "type": "domain",
    "enforcement": "require",
    "priority": "normal",
    "description": "MyBatis 종합 가이드 - #{} vs ${}, mapper.xml 패턴, 동적 SQL",
    "promptTriggers": {
      "keywords": [
        "MyBatis",
        "마이바티스",
        "mapper.xml",
        "동적SQL",
        "TypeHandler",
        "SQL 바인딩",
        "파라미터 바인딩",
        "SQL Injection",
        "${}",
        "InParameter",
        "쿼리 안전"
      ],
      "intentPatterns": [
        "(mybatis|마이바티스).*(작성|생성|수정)",
        "(mapper|매퍼).*(xml|작성|추가)",
        "(SQL|쿼리).*(바인딩|binding|injection)"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/mapper/**/*.xml"
      ],
      "contentPatterns": [
        "#{",
        "${",
        "<select",
        "<insert",
        "<update",
        "<delete"
      ]
    },
    "blockRules": [
      {
        "id": "ddl-destructive",
        "pattern": "\\b(DROP|TRUNCATE)\\s+(TABLE|INDEX|COLUMN)",
        "message": "DDL 파괴 명령 차단: DBA 승인 필수",
        "severity": "critical"
      },
      {
        "id": "delete-without-where",
        "pattern": "DELETE\\s+FROM\\s+\\w+\\s*$",
        "message": "WHERE 없는 DELETE 차단: 대량 삭제 위험",
        "severity": "critical"
      }
    ]
  },
