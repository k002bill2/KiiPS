  "kiips-test-runner": {
    "type": "validation",
    "enforcement": "require",
    "priority": "critical",
    "description": "JUnit 테스트 명시 실행 + 결과 분석 (Boris Cherny feedback loop). 명시 호출 전용.",
    "promptTriggers": {
      "keywords": [
        "테스트",
        "test",
        "junit",
        "검증",
        "validation",
        "테스트 실행",
        "run test",
        "자동 테스트",
        "auto test",
        "test coverage",
        "커버리지"
      ],
      "intentPatterns": [
        "(run|실행|execute).*?(test|테스트)",
        "(test|테스트).*?(자동|auto|automatic)",
        "(verify|검증|validate).*?(code|코드)",
        "(junit|karma|jest).*?(test|테스트)",
        "(coverage|커버리지).*?(check|확인|measure)"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/*Test.java",
        "**/*Tests.java",
        "**/test/**/*.java",
        "**/*.test.js",
        "**/*.spec.js",
        "**/test/**/*.js"
      ],
      "contentPatterns": [
        "@Test",
        "@RunWith",
        "describe\\(",
        "it\\(",
        "test\\("
      ]
    },
    "activationConditions": {
      "manual": "명시 호출 전용 — stopEvent 자동 테스트 실행은 v4.0에서 제거됨(과도하여)",
      "preventDuplicates": true
    }
  },
  "code-simplifier": {
    "type": "agent",
    "enforcement": "suggest",
    "priority": "normal",
    "description": "Post-implementation code refactoring and simplification (Boris Cherny principle)",
    "agentFile": ".claude/agents/code-simplifier.md",
    "model": "haiku",
    "promptTriggers": {
      "keywords": [
        "simplify",
        "단순화",
        "refactor",
        "리팩토링",
        "개선",
        "improve",
        "cleanup",
        "정리",
        "복잡",
        "complex",
        "complicated"
      ],
      "intentPatterns": [
        "(simplify|단순화).*?(code|코드)",
        "(refactor|리팩토링).*?(this|이|code|코드)",
        "(code|코드).*?(too|너무).*?(complex|복잡)",
        "(improve|개선).*?(code|코드|quality|품질)",
        "(cleanup|정리).*?(code|코드)",
        "(reduce|줄이|감소).*?(complexity|복잡도)"
      ]
    },
    "triggeredAfter": [
      "기능 구현 완료",
      "feature implementation complete",
      "/review shows high complexity"
    ],
    "capabilities": {
      "detectComplexity": true,
      "extractMethod": true,
      "guardClauses": true,
      "extractConditional": true,
      "eliminateDuplication": true,
      "preserveBehavior": true
    },
    "thresholds": {
      "cyclomaticComplexity": 10,
      "nestingDepth": 3,
      "methodLength": 50,
      "duplicationMinLines": 5
    }
  },
