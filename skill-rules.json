{
  "kiips-frontend-guidelines": {
    "type": "guideline",
    "enforcement": "suggest",
    "priority": "high",
    "promptTriggers": {
      "keywords": [
        "JSP",
        "JavaScript",
        "프론트엔드",
        "jQuery"
      ],
      "intentPatterns": [
        "(create|update|modify).*?(page|screen|UI|화면)",
        "(fix|style).*?(JSP|JavaScript)"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/jsp/**/*.jsp",
        "**/static/**/*.js",
        "**/static/**/*.css"
      ],
      "contentPatterns": [
        "<%@",
        "$(document)",
        "function "
      ]
    }
  },
  "kiips-a11y-guide": {
    "type": "guideline",
    "enforcement": "suggest",
    "priority": "high",
    "description": "KiiPS 웹 접근성(A11y) 가이드 - KWCAG/WCAG 4대 원칙, alt/aria/명도대비/키보드/모달 포커스",
    "promptTriggers": {
      "keywords": [
        "접근성",
        "웹접근성",
        "a11y",
        "aria",
        "ARIA",
        "alt",
        "스크린리더",
        "키보드 접근",
        "명도 대비",
        "포커스",
        "웹표준",
        "KWCAG",
        "WCAG"
      ],
      "intentPatterns": [
        "(create|update|modify|생성|수정|만들).*?(page|screen|UI|화면|페이지)",
        "(접근성|a11y|accessibility).*?(검사|점검|적용|개선)"
      ]
    },
    "fileTriggers": {
      "pathPatterns": [
        "**/jsp/**/*.jsp"
      ],
      "contentPatterns": [
        "aria-",
        "alt=",
        "role="
      ]
    }
  },
  "kiips-security-guide": {
    "type": "guardrail",
    "enforcement": "require",
    "priority": "critical",
    "description": "KiiPS 보안 가이드 - Spring Security, XSS 방어, CSRF, 인증/인가, 민감정보 보호",
    "promptTriggers": {
      "keywords": [
        "인증",
        "로그인",
        "JWT",
        "토큰",
        "비밀번호",
        "암호화",
        "보안",
        "XSS",
        "CSRF",
        "세션",
        "파일업로드"
      ],
      "intentPatterns": [
        ".*?(auth|login|token).*?",
        ".*?(password|secret|encrypt).*?",
        "(보안|security).*?(설정|config|check|검증)"
      ]
    }
  },
