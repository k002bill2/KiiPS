{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ethicalValidator.js"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/permissionGate.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,sys\ntry:\n p=json.load(sys.stdin).get('tool_input',{}).get('file_path','')\nexcept Exception:\n sys.exit(2)\nblocked=['.env','secrets','.git/','app-kiips.properties','app-stg.properties','app-local.properties','app-tibero.properties','app-production.properties','credentials','.secret','password']\nsys.exit(2 if any(b in p for b in blocked) else 0)\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mybatisBindingGuard.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/multiFileGate.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/jspXssGuard.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/impactAnalyzer.js"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/userPromptSubmit.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/postToolOrchestrator.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stopEvent.js && node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stopEvent.js || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-compact-save.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notificationHandler.js 2>>\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-errors.log || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/update-reminder.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/regressionGuard.sh || true"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/tests/catalog-integrity.sh 2>/dev/null | grep -E 'FAIL|drift' | head -5 || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "mcpContextUris": [],
  "thinking": {
    "enabled": true,
    "mode": "auto"
  },
  "autoAcceptEdits": false,
  "contextWindowWarningThreshold": 0.8,
  "lsp": {
    "java": {
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/.codex/lsp/jdtls.sh",
        "-data",
        "${workspaceFolder}/.jdt"
      ],
      "initializationOptions": {
        "workspace": "${workspaceFolder}",
        "settings": {
          "java": {
            "home": "/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home",
            "configuration": {
              "runtimes": [
                {
                  "name": "JavaSE-1.8",
                  "path": "/Library/Java/JavaVirtualMachines/jdk1.8.0_202.jdk/Contents/Home",
                  "default": true
                }
              ]
            },
            "project": {
              "referencedLibraries": [
                "**/*.jar"
              ]
            },
            "maven": {
              "downloadSources": true,
              "downloadJavadoc": false
            },
            "import": {
              "gradle": {
                "enabled": false
              }
            }
          }
        }
      },
      "rootPatterns": [
        "pom.xml",
        ".git"
      ],
      "filetypes": [
        "java"
      ]
    }
  }
}
