            "type": "command",
            "command": "node '/Users/younghwankang/WORK/WORKSPACE/KiiPS/.codex/hooks/postToolOrchestrator.js'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
