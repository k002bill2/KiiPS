{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/younghwankang/WORK/WORKSPACE/KiiPS/.codex/hooks/ethicalValidator.js'"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/younghwankang/WORK/WORKSPACE/KiiPS/.codex/hooks/permissionGate.js'"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import json,sys\ntry:\n p=json.load(sys.stdin).get('tool_input',{}).get('file_path','')\nexcept Exception:\n sys.exit(2)\nblocked=['.env','secrets','.git/','app-kiips.properties','app-stg.properties','app-local.properties','app-tibero.properties','app-production.properties','credentials','.secret','password']\nsys.exit(2 if any(b in p for b in blocked) else 0)\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/younghwankang/WORK/WORKSPACE/KiiPS/.codex/hooks/mybatisBindingGuard.js'"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/younghwankang/WORK/WORKSPACE/KiiPS/.codex/hooks/multiFileGate.js'"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/younghwankang/WORK/WORKSPACE/KiiPS/.codex/hooks/jspXssGuard.js'"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/younghwankang/WORK/WORKSPACE/KiiPS/.codex/hooks/impactAnalyzer.js'"
          }
        ]
      }
